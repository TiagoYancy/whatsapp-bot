# ============================================================
#  WhatsApp Business API (Meta)
# ============================================================
WHATSAPP_TOKEN=SEU_TOKEN_DE_ACESSO
WHATSAPP_PHONE_NUMBER_ID=SEU_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=SEU_BUSINESS_ACCOUNT_ID
WHATSAPP_APP_SECRET=SEU_APP_SECRET
GRAPH_VERSION=v21.0

# ============================================================
#  Webhook
# ============================================================
VERIFY_TOKEN=troque_por_um_token_aleatorio_longo
# true em produção (valida X-Hub-Signature-256)
VERIFY_SIGNATURE=false

# ============================================================
#  Servidor
# ============================================================
FLASK_ENV=development
FLASK_PORT=5000
HOST=0.0.0.0
WORKERS=4
LOG_LEVEL=INFO
# Token para proteger endpoints /api/* (vazio = aberto, apenas dev)
ADMIN_TOKEN=
# Simula envios sem chamar a API do WhatsApp
DRY_RUN=false

# ============================================================
#  Banco de dados
# ============================================================
DB_PATH=./data/bot.db

# ============================================================
#  FAQ
# ============================================================
FAQ_THRESHOLD=0.85

# ============================================================
#  IA (none | openai | ollama)
# ============================================================
AI_PROVIDER=none
AI_TIMEOUT=45
AI_MAX_HISTORY=10
AI_CONTEXT_ITEMS=3
AI_TEMPERATURE=0.3

# --- OpenAI ou compatível ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Ollama local ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest

# ============================================================
#  Comportamento
# ============================================================
BOT_NAME=Assistente Virtual
COMPANY_NAME=Nossa Empresa

# Escalonamento para humano
HUMAN_KEYWORDS=atendente,humano,pessoa,operador,atendimento humano,falar com alguem,gerente,supervisor
ADMIN_WHATSAPP_NUMBER=
NOTIFY_ADMIN_ON_HANDOFF=true

# Limite de mensagens por minuto por contato
RATE_LIMIT_PER_MINUTE=20

# Horário de atendimento
BUSINESS_HOURS_ENABLED=false
TIMEZONE=America/Sao_Paulo

# Palavras que abrem o menu
MENU_KEYWORDS=menu,opcoes,ajuda,help,inicio
